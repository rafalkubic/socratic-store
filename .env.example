# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
APP_BASE_URL=http://localhost:5000
SOCRATIC_AI_URL=http://localhost:8000
SOCRATIC_SHARED_AUTH_SECRET=replace-with-a-long-random-shared-secret

# MySQL
DATABASE_URL=mysql+pymysql://socratic_store:change-me@127.0.0.1:3306/socratic_store?charset=utf8mb4

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Facebook / Meta
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0

# Przelewy24
# For real payments set P24_ENABLED=true and provide merchant credentials.
P24_ENABLED=false
P24_SANDBOX=true
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=

# Development-only simulated payment button.
DEMO_PAYMENT_MODE=true

# Shop
SHOP_NAME=Socratic Store
SHOP_CONTACT_EMAIL=shop@example.local
